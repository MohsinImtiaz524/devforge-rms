# Database mode (PostgreSQL is required on Vercel)
DB_CLIENT=postgres

# Prefer a single hosted connection string on Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=1234
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_POOL_IDLE_MS=30000
DB_POOL_ACQUIRE_MS=10000
PG_POOL_MAX=5

# SSL Configuration (Uncomment if using a cloud DB like Supabase or Neon)
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false

# App Settings
PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
# Set true behind a trusted single reverse proxy such as Render.
TRUST_PROXY=false
# Production HTTPS deployments should keep this true.
SESSION_COOKIE_SECURE=false
# Optional comma-separated additional trusted browser origins.
CSRF_ALLOWED_ORIGINS=
# Session lifetime in milliseconds (default: 24 hours).
SESSION_MAX_AGE_MS=86400000
# Private persistent directory outside public/. Required for staff documents in production.
STAFF_DOCUMENT_STORAGE_DIR=./storage/staff-documents
PRINT_AGENT_SECRET=replace-with-a-long-random-secret
# Used by POST /internal/jobs/expenses-recurring. Configure the same value in the scheduler Authorization: Bearer header.
EXPENSES_CRON_SECRET=asdhfbfei7g4w9g8fiwef98weff8h:wjbewbefkjwbefuiebwfifjbwiefw
MAX_CONCURRENT_PDF_RENDERS=2
REALTIME_PRINT_MAX_ATTEMPTS=5
REALTIME_RECONCILE_MS=30000
INVENTORY_ALERT_INTERVAL_MS=1800000

# Private Cloudflare R2 object storage (server-only credentials)
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Shared private Files pipeline (additive rollout; default off)
FILES_ENABLED=false
# Existing R2_BUCKET_NAME, R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY are reused.
# Images-only release: PDF/SVG/HTML and other documents are not accepted.
# Shared operational limits (optional; shown with defaults)
FILES_MAX_PENDING_UPLOADS=20
FILES_SCOPE_QUOTA_BYTES=1073741824
FILES_UPLOAD_TTL_SECONDS=900
FILES_UNATTACHED_RETENTION_HOURS=24
FILES_JOB_MAX_ATTEMPTS=5
FILES_WORKER_INTERVAL_MS=5000
FILES_IMAGE_CONCURRENCY=1
FILES_IMAGE_QUEUE_LIMIT=4
FILES_STORAGE_TIMEOUT_MS=30000

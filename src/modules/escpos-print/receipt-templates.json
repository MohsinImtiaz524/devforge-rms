    "kitchen": {
      "nodes": [
        {
          "type": "text",
          "value": {
            "path": "data.kitchenName"
          },
          "align": "center",
          "bold": true
        },
        {
          "type": "text",
          "value": "KITCHEN ORDER",
          "align": "center",
          "bold": true
        },
        {
          "type": "text",
          "value": "#{{data.number}}{{data.updateLabel}}",
          "align": "center",
          "bold": true,
          "large": true
        },
        {
          "type": "text",
          "value": {
            "path": "data.upperOrderType"
          },
          "bold": true
        },
        {
          "type": "text",
          "value": "TABLE: {{data.table}}",
          "when": {
            "path": "data.hasTable"
          },
          "bold": true
        },
        {
          "type": "text",
          "value": "TOKEN: {{data.token}}",
          "when": {
            "path": "data.token"
          },
          "bold": true
        },
        {
          "type": "text",
          "value": "Time: {{data.time}}",
          "when": {
            "path": "data.time"
          }
        },
        {
          "type": "divider"
        },
        {
          "type": "table",
          "value": {
            "path": "data.items"
          },
          "headers": [
            "Qty",
            "Item Description"
          ],
          "widths": {
            "32": [
              6,
              25
            ],
            "48": [
              9,
              38
            ]
          },
          "aligns": [
            "center",
            "left"
          ],
          "cells": [
            "x{{item.quantity}}",
            {
              "path": "item.kitchenDescription"
            }
          ],
          "bold": true
        },
        {
          "type": "divider"
        },
        {
          "type": "text",
          "value": "Order Note:",
          "when": {
            "path": "data.note"
          },
          "bold": true
        },
        {
          "type": "text",
          "value": {
            "path": "data.note"
          },
          "when": {
            "path": "data.note"
          }
        },
        {
          "type": "text",
          "value": "Generated at {{data.generatedTime}}"
        }
      ]
